{
  // This package's tests open a real port, and are skipped where one cannot be
  // opened; its verifier's test runs against a local Supabase, and is skipped
  // where Docker is not running. A cached result from there must never be
  // replayed where they can run, so the test task is not cached.
  //
  // `CI` decides that nothing is skipped, and the Docker variables say which
  // daemon `docker info` and the Supabase CLI talk to.
  "extends": ["//"],
  "tasks": {
    "test": {
      "cache": false,
      "passThroughEnv": ["CI", "DOCKER_HOST", "DOCKER_CONTEXT"]
    },
    // The gateway's configuration, read by src/main.ts. Its secrets
    // (ANTHROPIC_API_KEY, SUPABASE_ANON_KEY) are read by name and never
    // listed where a cache key would hold them.
    "start": {
      "cache": false,
      "persistent": true,
      "env": [
        "GATEWAY_MODEL",
        "GATEWAY_EFFORT",
        "GATEWAY_ALLOWED_ORIGIN",
        "PORT"
      ]
    }
  }
}
